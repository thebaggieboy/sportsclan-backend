# Paystack secret key. Configure as a server environment variable; never expose
# this key in the mobile app or commit it to the real .env file.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
# Optional HTTPS callback configured in the Paystack dashboard.
# PAYSTACK_CALLBACK_URL=https://your-api-host.example/payments/return/
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1, sportsclan-backend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://localhost:3000,http://localhost:3102,https://sportsclanui.vercel.app

# Optional. Leave unset to use the local SQLite database.
# DATABASE_URL=postgresql://sportsclan:password@localhost:5432/sportsclan, sportsclan-backend.onrender.com